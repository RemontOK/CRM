# Timeweb FTP — скопируйте в .env.ftp и заполните пароль
# Панель Timeweb → Хостинг → FTP-доступ

FTP_HOST=vh440.timeweb.ru
FTP_PORT=21
FTP_USER=cc060567
FTP_PASSWORD=
FTP_REMOTE_DIR=crm/public_html

# FTPS (если обычный FTP не подключается — попробуйте true)
FTP_SECURE=false

# Пауза между файлами, мс (снижает нагрузку на shared-хостинг)
FTP_UPLOAD_DELAY_MS=300

# ЮMoney (для scripts/patch-yoomoney-config.cjs)
YOOMONEY_WALLET=
YOOMONEY_NOTIFICATION_SECRET=
