{
  "name": "nek-service-crm",
  "version": "1.0.0",
  "description": "CRM система для сервисного центра НЭК сервис",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.10.0",
    "@emotion/styled": "^11.10.0",
    "@hookform/resolvers": "^2.9.0",
    "@mui/icons-material": "^5.11.0",
    "@mui/material": "^5.11.0",
    "@mui/x-data-grid": "^5.17.0",
    "@mui/x-date-pickers": "^5.0.0",
    "@tinymce/tinymce-react": "^6.3.0",
    "@types/jspdf": "^1.3.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "axios": "^1.3.0",
    "dayjs": "^1.11.0",
    "framer-motion": "^10.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.43.0",
    "react-hot-toast": "^2.4.0",
    "react-query": "^3.39.0",
    "react-router-dom": "^6.8.0",
    "recharts": "^2.5.0",
    "tinymce": "^8.5.0",
    "xlsx": "^0.18.5",
    "yup": "^1.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "postbuild": "node scripts/copy-build-assets.cjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build:pages": "vite build --base=/CRM/ --outDir=build-pages",
    "deploy": "npm run build:pages && npx gh-pages -d build-pages",
    "deploy:prod": "npm run build && node scripts/deploy-prod.cjs",
    "deploy:until-done": "npm run build && node scripts/deploy-until-done.cjs",
    "deploy:ftp": "npm run build && node scripts/deploy-ftp.cjs",
    "deploy:ftp:frontend": "npm run build && node scripts/deploy-ftp.cjs --frontend-only",
    "deploy:ftp:api": "node scripts/deploy-ftp.cjs --api-only",
    "deploy:ftp:all": "npm run build && node scripts/deploy-ftp-until-done.cjs",
    "deploy:ftp:changed": "npm run build && node scripts/deploy-ftp-until-done.cjs --frontend-only"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@vitejs/plugin-react": "^5.0.4",
    "basic-ftp": "^5.3.1",
    "gh-pages": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
