RewriteEngine On

# Canonical host: www → apex
RewriteCond %{HTTP_HOST} ^www\.nakcrm\.ru$ [NC]
RewriteRule ^ https://nakcrm.ru%{REQUEST_URI} [R=301,L]

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|build-version\.json|asset-manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Все JS/CSS — без immutable: после деплоя Chrome иначе держит старые vendor/mui чанки
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Не кэшировать index.html — иначе браузер держит старый бандл
<Files "index.html">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</Files>

# API — отдельное приложение, не SPA
RewriteRule ^api(/|$) - [L]

# Существующие файлы в /assets/ — отдаём как статику
RewriteCond %{REQUEST_URI} ^/assets/ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Отсутствующий /assets/* — настоящий 404 (не index.html, иначе .js получает text/html)
RewriteCond %{REQUEST_URI} ^/assets/ [NC]
RewriteRule ^ - [R=404,L]

# TinyMCE — статика из /tinymce/
RewriteCond %{REQUEST_URI} ^/tinymce/ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_URI} ^/tinymce/ [NC]
RewriteRule ^ - [R=404,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# History mode: все маршруты CRM → index.html
RewriteRule ^ index.html [L]
